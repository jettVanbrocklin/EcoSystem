  "figures": [
    {
      "file": "figures/eda_class_balance.png",
      "title": "Class balance",
      "interpretation": "Moderate stress is the majority class (743 of 1600; 46.44%), while healthy has only 192 records (12.00%). A constant-majority prediction therefore gives 46.44% development-training accuracy; macro F1 and per-class recall are needed to expose minority-class failures."
    },
    {
      "file": "figures/eda_numeric_distributions.png",
      "title": "Numeric sensor distributions",
      "interpretation": "The broad, fairly flat sensor distributions are consistent with simulated ranges, rather than evidence of measured natural variability. Their scales differ substantially, motivating training-fitted standardization for linear models; uncertain gas units remain unconverted."
    },
    {
      "file": "figures/eda_missing_values.png",
      "title": "Missing values",
      "interpretation": "All 14 development-training fields have zero missing values. No imputation or row deletion is needed for this snapshot, although a training-fitted imputer remains planned for the reusable pipeline."
    },
    {
      "file": "figures/eda_category_frequencies.png",
      "title": "Categorical frequencies",
      "interpretation": "Plant types and seasons are relatively evenly represented, whereas habitats are uneven: greenhouse and indoor are common and arid_garden/hydroponic are much smaller groups. These counts describe coverage in synthetic development data, not real-world prevalence."
    },
    {
      "file": "figures/eda_sensors_by_class.png",
      "title": "Sensor distributions by class",
      "interpretation": "Leaf color, ethylene, and oxygen show visible class shifts, but distributions overlap and the synthetic scoring recipe can create these associations without establishing biological causation. Boxplot fliers use within-class IQR fences, which differ from the overall-development IQR screen reported in the range audit; no fliers were removed."
    },
    {
      "file": "figures/eda_categories_by_class.png",
      "title": "Class proportions by context",
      "interpretation": "Class proportions vary across context categories, so categorical inputs may encode part of the synthetic label-generation process. Each bar is normalized within its category; inspect the preceding frequency plot before interpreting differences in smaller groups."
    },
    {
      "file": "figures/eda_sensor_correlations.png",
      "title": "Sensor correlation matrix",
      "interpretation": "The largest absolute off-diagonal Pearson correlation is only 0.044 (soil_humidity_pct versus ethylene_ppm); no strong linear sensor redundancy appears. Near-zero correlation does not prove independence: nonlinear dependence may remain, and correlated predictors, if present, can destabilize individual coefficients even when predictions are stable."
    },
    {
      "file": "figures/eda_pairwise_sensors.png",
      "title": "Selected sensor pairs",
      "interpretation": "The leaf-color/ethylene panel shows class structure with substantial overlap; temperature/soil-moisture does not show an obvious single linear class boundary. These are descriptive views of two selected pairs, not evidence that remaining features are unimportant or that any classifier will generalize."
    },
    {
      "file": "figures/eda_score_leakage.png",
      "title": "Excluded score and label-generation audit",
      "interpretation": "In these development-training records, high stress occupies scores 0-54, moderate stress 55-79, and healthy 80-100; no observed score maps to multiple classes. Thresholds at 55 and 80 reproduce all observed labels, providing post-hoc leakage evidence rather than an independently evaluated model; health_score remains excluded from all predictors."
    }
  ]
